{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "lora": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["unet", 0],
      "lora_name": "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors",
      "strength_model": 1.0
    }
  },
  "vae_video": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_video_vae_int8_convrot.safetensors" }
  },
  "vae_audio": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" }
  },
  "first_img": {
    "class_type": "LoadImage",
    "inputs": { "image": "example_first_frame.png" }
  },
  "i2v": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["clip", 0],
      "vae": ["vae_video", 0],
      "prompt": "The object rotates slowly as studio lighting sweeps across it, soft ambient electronic music.",
      "width": 1344,
      "height": 768,
      "length": 124,
      "first_frame": ["first_img", 0]
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": 1 }
  },
  "sampler": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "res_multistep" }
  },
  "sched": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["unet", 0],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1.0
    }
  },
  "guider": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["unet", 0],
      "conditioning": ["i2v", 0]
    }
  },
  "sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["noise", 0],
      "guider": ["guider", 0],
      "sampler": ["sampler", 0],
      "sigmas": ["sched", 0],
      "latent_image": ["i2v", 1]
    }
  },
  "dec_video": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["sample", 0], "vae": ["vae_video", 0] }
  },
  "dec_audio": {
    "class_type": "VAEDecodeAudio",
    "inputs": { "samples": ["sample", 0], "vae": ["vae_audio", 0] }
  },
  "video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["dec_video", 0],
      "audio": ["dec_audio", 0],
      "fps": 24.0,
      "bit_depth": 8
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["video", 0],
      "filename_prefix": "video/MiniMax_H3",
      "format": "auto",
      "codec": "auto"
    }
  }
}
